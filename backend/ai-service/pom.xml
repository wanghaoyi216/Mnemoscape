<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mnemoscape</groupId>
        <artifactId>mnemoscape-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ai-service</artifactId>
    <packaging>jar</packaging>
    <name>Mnemoscape AI Service</name>

    <dependencies>
        <dependency>
            <groupId>com.mnemoscape</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- AMQP / RabbitMQ consumer for vector-index / vector-evict queues
             driven by memory-service domain events.  See
             com.mnemoscape.ai.messaging.RabbitConsumerConfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Security auto-configuration so the SecurityFilterChain bean
             defined in SecurityConfig is picked up.  Used for the admin-dashboard
             dual-layer enforcement: any direct call to /api/v1/admin/** that
             bypasses the gateway is rejected here with hasRole('ADMIN').
             (admin-dashboard Requirements 3.2) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 分布式追踪试点：Micrometer Tracing 桥接 OpenTelemetry，
             经 OTLP HTTP 上报 Jaeger。版本由父工程导入的 spring-boot-dependencies(3.2.5)
             BOM 统一管理（micrometer-tracing 1.2.x）；exporter-otlp-common 是
             management.otlp.tracing.* 自动配置的必需依赖。actuator 已在上方引入。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos Config — 业务调参（缓存 TTL / 限流 RPM / 视觉模型 ID / Embedding
             模型 / Milvus 集合名 等）走 Nacos 后即可热更新，配合
             {@code @RefreshScope} 注解无需重启服务。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Spring Cloud 2023.x 默认禁用 bootstrap.yml；显式引入 starter 启用，
             这样 Nacos config / Spring Cloud Config 等"启动期"配置源能加载。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- Spring AI OpenAI-compatible starter (NVIDIA Integrate API speaks
             the OpenAI wire protocol; we override base-url/api-key in
             application.yml and target the MiniMax-M2.7 model).
             NOTE: the starter's transitive spring-ai-core resolves to a stale
             0.8.x artifact in M4, so we pin spring-ai-core explicitly to the
             BOM-managed version to get the new ChatClient/ChatModel APIs. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-core</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
        </dependency>
        <!-- Reactor for SSE bridging from ChatClient.stream() Flux<ChatResponse>
             to Spring MVC SseEmitter. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- Reactive WebClient: used by AssetServiceClient + tool callbacks.
             Brought in via the WebFlux starter so we don't pull in additional
             autoconfig surfaces that would conflict with spring-boot-starter-web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Spring Data Neo4j for the neo4jRelationTool — same dependency the
             memory-service uses. Optional at runtime; the tool degrades to an
             empty-result response when Neo4jClient is absent or unreachable. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>
        <!-- OpenFeign so the AI service can talk to memory-service (used by
             milvusSearchTool: until a true vector store is wired up, the tool
             scores against the user's actual memory rows). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Resilience4j for circuit-breaking external AI providers -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!-- Test scope: JUnit 5 (via Spring Boot test starter) + jqwik for
             bugfix property-based exploration tests under src/test/java/.../bugfix.
             These tests are intentionally strict about real-LLM / model-stream
             behavior so that the current (templated, sleep-paced) implementation
             FAILS them — proving the bug exists. After the fix lands, they pass. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.8.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- jqwik registers its TestEngine via JUnit5 SPI; surefire
                         needs to include the jupiter engine which it does by default.
                         No extra include patterns required. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
