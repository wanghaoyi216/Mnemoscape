# ============================================================================
# Mnemoscape — Local dev → remote workpc middleware
# ============================================================================
# Drop this file at backend/.env.workpc.  Source it before starting Spring
# Boot services on the dev laptop so they reach the workpc Tailscale IP.
#
#   PowerShell:  Get-Content .\backend\.env.workpc | ForEach-Object {
#                  if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#                    [Environment]::SetEnvironmentVariable($Matches[1].Trim(),
#                                                          $Matches[2].Trim(),
#                                                          'Process')
#                  }}
#
#   Git Bash:    set -a; source backend/.env.workpc; set +a
#
# Then run individual services as usual:
#   .\backend\mvnw -pl auth-service spring-boot:run
#   .\backend\mvnw -pl memory-service spring-boot:run
#   ...
# ============================================================================

# ----- Connection target -----------------------------------------------------
MNEMOSCAPE_REMOTE_HOST=100.66.166.46

# ----- MySQL -----------------------------------------------------------------
MYSQL_HOST=100.66.166.46
MYSQL_USER=root
MYSQL_PASSWORD=root123

# ----- Redis (cache & rate-limit) -------------------------------------------
REDIS_HOST=100.66.166.46
REDIS_PORT=6379

# ----- Nacos (service registry & config) ------------------------------------
NACOS_HOST=100.66.166.46
NACOS_PORT=8848

# ----- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=100.66.166.46
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ----- Neo4j (memory association graph) -------------------------------------
NEO4J_HOST=100.66.166.46
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ----- MinIO (asset object storage) -----------------------------------------
MINIO_ENDPOINT=http://100.66.166.46:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ----- Milvus (emotion vector store) ----------------------------------------
MILVUS_HOST=100.66.166.46
MILVUS_PORT=19530

# ----- Nacos service registration override for local dev ---------------------
# 本机 Tailscale IP（100.x.x.x 段），让 Nacos 注册的地址指向本机真实可达 IP。
# 远程 workpc 上的 api-gateway 通过 Nacos 发现服务后，会经 Tailscale 路由到此 IP。
# 如果本机 Tailscale IP 变化，请同步更新此值（tailscale ip -4 可查询）。
SPRING_CLOUD_NACOS_DISCOVERY_IP=100.126.216.61

# ----- JWT — keep identical across services ---------------------------------
JWT_SECRET=bW5lbW9zY2FwZS1zZWNyZXQta2V5LWZvci1obWFjLXNoYTI1Ni1hbGdvcml0aG0tMjAyNQ==

# ----- AI 上游（NVIDIA Integrate API · MiniMax-M2.7） ------------------------
# 在 NVIDIA Integrate (https://integrate.api.nvidia.com) 申请到密钥后，把下面
# 的注释去掉并填上真实值 — Start-LocalDevServices.ps1 / docker-compose 会自动
# 加载。**不填的话也不会阻塞**：ai-service 会启动成功，/chat 走结构化降级，
# memory 重建走 MockReconstructService。
#
NVIDIA_API_KEY=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
# ⚠️ base-url 不要带 `/v1`：Spring AI 客户端会自动拼 `/v1/chat/completions`。
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=minimaxai/minimax-m2.7

# ----- Spring profile suggestion --------------------------------------------
SPRING_PROFILES_ACTIVE=dev
