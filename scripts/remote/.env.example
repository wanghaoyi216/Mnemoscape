# =============================================================================
# Mnemoscape — Remote 部署环境变量模板
#
# 用法：复制为 scripts/remote/.env（docker compose 会自动读取 compose 文件同目录
# 的 .env），或用 `docker compose --env-file <file>` 显式指定。填好后再执行
# Deploy-Remote.ps1 / docker compose up，否则带 :? 占位符的服务会直接构建失败。
# =============================================================================

# JWT 签名密钥（api-gateway 验签 + auth-service 签发共用）。
# 注入机制：网关消费 JWT_SECRET；auth-service 经 compose 的 MNEMOSCAPE_JWT_SECRET
# 映射到其 mnemoscape.jwt.secret 属性（Spring relaxed binding）。两端同源，缺一不可。
# 生成强密钥：openssl rand -base64 48
JWT_SECRET=<replace-with-your-base64-jwt-secret>
