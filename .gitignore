# =============================================================================
# Mnemoscape · Repository ignore rules
# 仓库可能转公开，凭证文件不再提交：含真实 NVIDIA API Key / 工位机连接密码
# 的 .env.workpc 必须本地保留但不进 git 历史。密钥统一走环境变量注入。
# =============================================================================
# ---- 本地凭证文件（不进 git，文件留在硬盘供本地 dev 用）----
backend/.env.workpc
*.env.workpc
**/.env
**/.env.local

# ---- Node / 前端 ----
**/node_modules/
frontend/dist/
frontend/dist.tar.gz
**/.vite/
**/.eslintcache
**/.parcel-cache/
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Java / Maven ----
**/target/
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.class
hs_err_pid*
replay_pid*

# ---- Spring 本地缓存 ----
**/.spring-boot-devtools.properties

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/
*.code-workspace
*.swp
*.swo

# ---- OS 噪音 ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- 日志 ----
*.log
logs/
**/logs/

# ---- 测试覆盖率 ----
coverage/
.nyc_output/
**/test-output/
**/surefire-reports/
**/jacoco.exec

