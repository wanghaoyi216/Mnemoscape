# =============================================================================
# Mnemoscape · Environment variable template
# =============================================================================
# 把这份文件复制为 `.env`（同级目录），填好真实值，然后 docker-compose / 本地启动
# 时会自动注入 — **永远不要把真实密钥写进 application.yml**，那份文件会进 git。
#
# 复制示例：
#   cp .env.example .env
#   # 编辑 .env 填入真实值（Linux / macOS 不要在引号里粘贴密钥；Windows PowerShell：
#   #   $env:NVIDIA_API_KEY = "nvapi-xxx"）
# =============================================================================

# ----- AI 上游 (NVIDIA Integrate / MiniMax-M2.7) -----
# 申请地址：https://integrate.api.nvidia.com   未填留空 → ai-service 直接返回结构化降级。
NVIDIA_API_KEY=
# ⚠️ base-url 不要带 `/v1`：Spring AI 客户端会自动拼 `/v1/chat/completions`。
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=minimaxai/minimax-m2.7
AI_TIMEOUT_MS=30000

# ----- 多模态混合检索 (hybrid retrieval) -----
# 基座模型保持 M2.7（强中文/agentic/工具调用）；附件场景临时切到视觉模型。
# 默认走 Llama 3.2 11B Vision（同步 chat/completions，~5s 返回稳定）。
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# 降级备份（90B 视觉精度更高但慢）。
NVIDIA_VISION_FALLBACK_MODEL=meta/llama-3.2-90b-vision-instruct
# 单次会话最多让视觉模型读多少张图片，防 prompt 失控。
NVIDIA_VISION_MAX_IMAGES=4
# 视觉模型单次调用硬上限（毫秒）。
NVIDIA_VISION_TIMEOUT_MS=45000

# ----- 场景重建路由 -----
# auto = 先 LLM 创意重建，失败/超时降级规则版（默认）
# llm  = 强制 LLM（调试用）
# rule = 强制规则版（离线 / 无 key 环境）
RECONSTRUCT_MODE=auto

# ----- 实体提取（NER）路由 -----
# 同样三档；从记忆描述里抽人物/地点/物件/情绪标签，写入 Neo4j 图谱
EXTRACT_MODE=auto

# ----- 真实向量检索 (Embedding + Milvus) -----
# enabled=false → 关闭向量检索，AI 检索退回关键词加权（离线 / 无 Milvus 环境）。
VECTOR_SEARCH_ENABLED=true
# NVIDIA Integrate 上的检索专用 embedding 模型；换模型必须同步改 EMBEDDING_DIMENSION。
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=15000
# Milvus（REST API v2，gRPC/REST 共用 19530 端口）。
MILVUS_HOST=milvus
MILVUS_PORT=19530
# 单机 dev 一般为空；云端 / 开启鉴权时填 username:password 或 root token。
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=mnemoscape_memories
MILVUS_TIMEOUT_MS=8000
VECTOR_DEFAULT_TOPK=5

# ----- 数据存储 -----
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=root123
NEO4J_HOST=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ----- 中间件 -----
NACOS_HOST=nacos
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ----- MinIO 对象存储 -----
# 真实部署务必替换为强随机密钥，不要使用下面的 dev 默认值。
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=mnemoscape-assets
MINIO_PRESIGNED_TTL_SECONDS=3600

# ----- 本地静态资源目录 -----
# 不配置时 asset-service 会按相对路径寻找 resource/；本机特殊路径放环境变量，不写进代码。
MNEMOSCAPE_RESOURCE_DIR=

# ----- 鉴权 -----
# Base64-encoded 64 字节随机密钥。开发期固定值仅为本地联调，生产请重置。
JWT_SECRET=bW5lbW9zY2FwZS1zZWNyZXQta2V5LWZvci1qd3Qtc2lnbmluZy1hbmQtdmVyaWZpY2F0aW9u
