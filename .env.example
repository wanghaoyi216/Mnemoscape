# =============================================================================
# Mnemoscape · Environment variable template
# =============================================================================
# 把这份文件复制为 `.env`（同级目录），填好真实值，然后 docker-compose / 本地启动
# 时会自动注入 — **永远不要把真实密钥写进 application.yml**，那份文件会进 git。
#
# 复制示例：
#   cp .env.example .env
#   # 编辑 .env 填入真实值（Linux / macOS 不要在引号里粘贴密钥；Windows PowerShell：
#   #   $env:NVIDIA_API_KEY = "nvapi-xxx"）
# =============================================================================

# ----- AI 上游 (NVIDIA Integrate / MiniMax-M2.7) -----
# 申请地址：https://integrate.api.nvidia.com   未填留空 → ai-service 直接返回结构化降级。
NVIDIA_API_KEY=
# ⚠️ base-url 不要带 `/v1`：Spring AI 客户端会自动拼 `/v1/chat/completions`。
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=minimaxai/minimax-m2.7
AI_TIMEOUT_MS=30000

# ----- 数据存储 -----
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=root123
NEO4J_HOST=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ----- 中间件 -----
NACOS_HOST=nacos
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ----- MinIO 对象存储 -----
# 真实部署务必替换为强随机密钥，不要使用下面的 dev 默认值。
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=mnemoscape-assets
MINIO_PRESIGNED_TTL_SECONDS=3600

# ----- 本地静态资源目录 -----
# 不配置时 asset-service 会按相对路径寻找 resource/；本机特殊路径放环境变量，不写进代码。
MNEMOSCAPE_RESOURCE_DIR=

# ----- 鉴权 -----
# Base64-encoded 64 字节随机密钥。开发期固定值仅为本地联调，生产请重置。
JWT_SECRET=bW5lbW9zY2FwZS1zZWNyZXQta2V5LWZvci1qd3Qtc2lnbmluZy1hbmQtdmVyaWZpY2F0aW9u
